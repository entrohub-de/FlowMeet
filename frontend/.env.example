# Supabase Configuration
# Get these values from your Supabase project dashboard
# https://supabase.com/dashboard/project/_/settings/api

# Public Supabase URL (use /supabase-proxy for local dev with mobile access)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase direct URL (server-side API routes bypass the proxy)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Service Role Key (server-side only, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Storage (S3) - Local Supabase storage configuration
SUPABASE_S3_URL=http://127.0.0.1:54321/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=your_s3_access_key
SUPABASE_S3_SECRET_KEY=your_s3_secret_key
SUPABASE_S3_REGION=local

# OpenAI API Key (for conversation topic generation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# FlowMeet API Keys (for MCP server / external API access)
FLOWMEET_API_KEYS=agent1:sk-your-key-here

# Test Simulator Secret (development only)
# Set the same value on both server and client side
TEST_SIMULATOR_SECRET=any-random-secret-for-local-dev
NEXT_PUBLIC_TEST_SIMULATOR_SECRET=any-random-secret-for-local-dev

# PostHog Analytics (optional)
# Get your API key from: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com


STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret