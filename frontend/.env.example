# Supabase Configuration
# Get these values from your Supabase project dashboard
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (only for scripts, NEVER expose to frontend)
# Used by: node scripts/create-test-users.mjs
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# OpenAI API Key (for conversation topic generation)
# Get your API key from: https://platform.openai.com/api-keys
# This is used by the Supabase Edge Function to generate AI-powered conversation topics
OPENAI_API_KEY=your_openai_api_key_here
